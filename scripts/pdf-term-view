#!/bin/bash
# PDF viewer inside a kitty window: draws ONE page, pinned to the pane, via the kitty
# graphics protocol; reloads when the file changes. Keys: k/space next page, j prev,
# g first, G last, q quit.

pdf="$1"
[ -f "$pdf" ] || { echo "Usage: pdf-term-view <file.pdf>"; exit 1; }

out="$(mktemp -d)"
saved_tty="$(stty -g)"
cleanup() { rm -rf "$out"; stty "$saved_tty"; printf '\e[?25h\e[?1049l'; }
trap cleanup EXIT
stty -icanon -echo
printf '\e[?1049h\e[?25l'

page=1
last=""
n=1

draw() {
    local rows cols
    rows=$(tput lines); cols=$(tput cols)
    [ "$page" -gt "$n" ] && page=$n
    [ "$page" -lt 1 ] && page=1
    pdftoppm -png -r 110 -f "$page" -l "$page" -singlefile "$pdf" "$out/page" 2>/dev/null
    printf '\e[H'
    kitten icat --image-id 4243 --place "${cols}x$((rows - 1))@0x0" --scale-up --align center "$out/page.png" 2>/dev/null
    printf '\e[%d;1H\e[2K %s  %d/%d  j/k prev/next  g/G first/last  q quit' "$rows" "$(basename "$pdf")" "$page" "$n"
}

while :; do
    now="$(stat -c %Y.%y "$pdf" 2>/dev/null)" || exit 0
    if [ "$now" != "$last" ]; then
        last="$now"
        n=$(pdfinfo "$pdf" 2>/dev/null | awk '/^Pages:/ {print $2}')
        n=${n:-1}
        draw
    fi
    if read -rsn1 -t 0.2 key; then
        case "$key" in
            k|' ') page=$((page + 1)) ;;
            j) page=$((page - 1)) ;;
            g) page=1 ;;
            G) page=$n ;;
            q) exit 0 ;;
        esac
        draw
    fi
done
