#!/usr/bin/env python3
"""Hitos de estudio en gv para la skill estudio-asentar.

Solo lee gv, salvo `plan --aplicar` (creación inicial de un tema) y los subcomandos de
corrección, que solo se usan cuando el usuario lo pide expresamente.

`plan --aplicar`:
  - due_at para los bloques marcados como hito que aún no tienen fecha; la fecha sale del ritmo
    repartido entre todos los bloques de cada tramo (antes de cada entrega y después de la
    última), y los que no son hito heredan en gv la del siguiente hito por la cadena de
    dependencias (task_effective_due),
  - tareas nuevas de bloque, encadenadas entre sí, si el plan las trae,
  - las entregas que no existan, o su due_at si no lo tienen, y la dependencia de cada entrega
    con el último bloque de su tramo,
  - el due_at del proyecto (fin de la asignatura) si no lo tiene y el plan trae "fin_asignatura",
  - el repaso semanal recurrente de la asignatura y su repaso final, si no existen.
  Nunca marca tareas como hechas, ni borra, ni cambia fechas ya puestas, ni añade a tareas que ya
  existían más dependencias que las de cada entrega con su último bloque.

  estudio-plan proyectos                     lista proyectos (para saber el id de la asignatura)
  estudio-plan estado <proyecto_id>          estado del proyecto en gv (solo lectura)
  estudio-plan plan <plan.json> [--hoy AAAA-MM-DD] [-o fichero.sql] [--aplicar]
                    [--como-borradas id,id,...]   (solo en seco: calcula como si esas tareas no existieran;
                                                   para replanificar antes de borrarlas)
Corrección (sin --aplicar solo muestran el cambio):
  estudio-plan mover <tarea> <AAAA-MM-DD> [--aplicar]   cambia el due_at de una tarea abierta
  estudio-plan dep <tarea> <de> [--aplicar]             <tarea> pasa a depender de <de>
  estudio-plan quitar-dep <tarea> <de> [--aplicar]      quita esa dependencia
  estudio-plan borrar <tarea>... [--aplicar]            borra tareas abiertas sin tiempo registrado
  estudio-plan horas <tarea> <h> [<tarea> <h>...] [--aplicar]  cambia las horas estimadas
  estudio-plan repasos <proyecto> <importancia> [--aplicar]  ajusta horas y minutos de sus repasos a la importancia

plan.json:
  {
    "proyecto": 23, "tema": "R3", "abrev": "MN",           # abrev opcional
    "importancia": 3,               # 1-3, de <asignatura>/estudio-asignatura.md (defecto 2; en 1 no hay repasos)
    "entregas": [                   # en orden de fecha; cada una es un id o un objeto:
      323,                          #   tarea existente
      {"id": 340, "due_at": "2026-12-09"},                  # pone due_at si no tiene
      {"nombre": "PEC8", "due_at": "2026-12-21", "horas": 6, "dias": 3}  # la crea
    ],                              # ("entrega": X sigue valiendo para una sola)
    "dias_entrega": 3,              # días reservados antes de cada entrega (defecto 2; "dias" por entrega)
    "fin_asignatura": "2027-01-15", # solo si el proyecto no tiene due_at
    "inicio": "2026-11-26",         # opcional; por defecto, hoy
    "fin": "2026-12-30",            # opcional: último día de los bloques de deuda ("despues"); defecto y
                                    #   tope: el fin de la asignatura
    "max_por_dia": 1,               # bloques por día (sube a 2 solo si no caben)
    "bloques": [                    # en orden; cada bloque va al tramo de su entrega
      {"id": 312},                                          # existente, sin fecha propia (tramo de la entrega 1)
      {"id": 313, "hito": true},                            # hito: lleva due_at
      {"nombre": "PCA (I)", "descripcion": "...", "horas": 1.5, "entrega": 2},  # nuevo, antes de la entrega 2
      {"id": 318, "despues": true, "hito": true}            # deuda: tras la última entrega
    ]                               # sin "entrega" ni "despues", un bloque va al tramo del anterior
  }
"""

import csv
import datetime as dt
import io
import json
import math
import re
import subprocess
import sys
import unicodedata

DIAS = ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"]
SEMANAL = "ea:repaso-semanal"
FINAL = "ea:repaso-final"
MARGEN_FINAL = 7  # el repaso final va 7 días antes del fin de la asignatura
# Horas del repaso semanal y del final por importancia de la asignatura (1-3, decididas por el
# usuario). En importancia 1 no hay repasos.
HORAS_SEMANAL = {1: None, 2: 0.33, 3: 1.00}
HORAS_FINAL = {1: None, 2: 1.00, 3: 2.00}


class Error(Exception):
    pass


def die(msg):
    raise Error(msg)


def sql_query(query):
    proc = subprocess.run(
        ["gv-api-sql"],
        input="\\set QUIET on\n\\pset format csv\n" + query,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        die(f"fallo consultando gv:\n{proc.stderr.strip()}")
    return list(csv.DictReader(io.StringIO(proc.stdout)))


def q(value):
    return "'" + str(value).replace("'", "''") + "'"


def fecha(s):
    return dt.date.fromisoformat(s) if s else None


def slug(s):
    s = unicodedata.normalize("NFKD", str(s)).encode("ascii", "ignore").decode().lower()
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")


def abrev_de(nombre):
    palabras = [p for p in re.split(r"\s+", nombre) if len(p) > 2]
    return "".join(p[0].upper() for p in palabras) or nombre[:3].upper()


def horas_de(valor):
    if valor in (None, ""):
        return "null"
    try:
        h = float(str(valor).replace(",", "."))
    except ValueError:
        die(f"horas no numéricas: {valor!r}")
    if not 0 < h < 1000:
        die(f"horas fuera de rango: {valor!r}")
    return f"{h:.2f}"


def tabla(filas, cabecera):
    anchos = [max(len(str(x)) for x in col) for col in zip(cabecera, *filas)]
    linea = lambda f: "  ".join(str(x).ljust(a) for x, a in zip(f, anchos)).rstrip()
    return "\n".join([linea(cabecera), linea(["-" * a for a in anchos])] + [linea(f) for f in filas])


# ---------------------------------------------------------------- proyectos / estado


def cmd_proyectos():
    filas = sql_query(
        "select p.id, coalesce(pp.name, '') as padre, p.name, coalesce(p.due_at::text, '') as fin "
        "from projects p left join projects pp on pp.id = p.parent_id "
        "where p.finished_at is null order by pp.name nulls first, p.id;"
    )
    print(tabla([[f["id"], f["padre"], f["name"], f["fin"]] for f in filas], ["id", "padre", "nombre", "fin"]))


def cmd_estado(proyecto, hoy):
    pid = int(proyecto)
    p = sql_query(f"select name, due_at from projects where id = {pid};")
    if not p:
        die(f"no existe el proyecto {pid}")
    filas = sql_query(
        f"""select t.id, t.name, t.task_type, coalesce(t.due_at::text, '') as due,
               coalesce(t.estimate_hours::text, '') as horas,
               coalesce((t.finished_at at time zone 'Europe/Madrid')::date::text, '') as hecha,
               exists (select 1 from task_dependencies d join tasks b on b.id = d.depends_on
                       where d.task_id = t.id and b.finished_at is null) as bloqueada
        from tasks t where t.project_id = {pid}
          and (t.finished_at is null or t.finished_at > now() - interval '14 days')
        order by (t.finished_at is not null), t.due_at nulls last, t.id;"""
    )
    fin = fecha(p[0]["due_at"])
    print(f"{p[0]['name']} · fin {fin or '—'}" + (f" (faltan {(fin - hoy).days} días)" if fin else ""))
    out = []
    for f in filas:
        due = fecha(f["due"])
        if f["hecha"]:
            marca = f"hecha {f['hecha']}"
        elif due and due < hoy:
            marca = f"VENCIDA ({(hoy - due).days} d)"
        elif due == hoy:
            marca = "hoy"
        else:
            marca = "bloqueada" if f["bloqueada"] == "t" else ""
        tipo = "recurrente" if f["task_type"] == "recurring" else ""
        out.append([f["id"], f["name"], f["due"] or "—", f["horas"], marca, tipo])
    print(tabla(out, ["id", "tarea", "due_at", "h", "estado", ""]))


# ---------------------------------------------------------------- plan


def repartir(n, ini, fin, max_por_dia, etiqueta):
    """n fechas de hito repartidas uniformemente en [ini, fin], en orden."""
    if n == 0:
        return [], []
    if fin < ini:
        die(
            f"{etiqueta}: no hay días entre {ini} y {fin}. Pasa esos bloques a \"despues\", "
            "baja dias_entrega o cambia el inicio."
        )
    k = (fin - ini).days + 1
    avisos = []
    if n > k * max_por_dia:
        if max_por_dia < 2 and n <= k * 2:
            avisos.append(f"{etiqueta}: {n} bloques en {k} días: hay días con 2 bloques")
        else:
            die(
                f"{etiqueta}: {n} bloques no caben en {k} días ({ini} a {fin}) ni a 2 por día. "
                "Pasa bloques a \"despues\", reduce el alcance o pide más días."
            )
    # Punto medio de n tramos iguales: crece con i; 1 por día si n ≤ k; como mucho 2 si n ≤ 2k.
    return [ini + dt.timedelta(days=math.floor((i + 0.5) * k / n)) for i in range(n)], avisos


def cmd_plan(ruta, hoy, salida, aplicar, borradas=frozenset()):
    if borradas:
        print(f"(simulación: como si no existieran {', '.join(map(str, sorted(borradas)))})", file=sys.stderr)
    if borradas and aplicar:
        die("--como-borradas es solo para el dry-run: borra primero esas tareas y aplica sin la opción")
    try:
        with open(ruta) as fh:
            plan = json.load(fh)
    except (OSError, json.JSONDecodeError) as e:
        die(f"no se puede leer {ruta}: {e}")
    pid = int(plan["proyecto"])
    tema = slug(plan.get("tema", "")) or die("falta 'tema'")
    inicio = fecha(plan.get("inicio")) or hoy
    max_por_dia = int(plan.get("max_por_dia", 1))
    if max_por_dia < 1:
        die("max_por_dia debe ser 1 o más")
    bloques = plan.get("bloques")
    if not isinstance(bloques, list):
        die("falta la lista 'bloques' (puede ser [])")

    p = sql_query(f"select name, due_at, priority from projects where id = {pid};")
    if not p:
        die(f"no existe el proyecto {pid}")
    pnombre, fin_asig, prioridad = p[0]["name"], fecha(p[0]["due_at"]), int(p[0]["priority"])
    previas = []  # sentencias que van antes de las de bloques (fin de la asignatura, entrega nueva)
    filas_previas = []
    if not fin_asig:
        fin_asig = fecha(plan.get("fin_asignatura"))
        if not fin_asig:
            die(f'el proyecto {pid} no tiene due_at (fin de la asignatura): pon "fin_asignatura" en el plan')
        previas.append(f"update projects set due_at = {q(fin_asig)} where id = {pid} and due_at is null;")
        filas_previas.append([pid, pnombre, fin_asig, "fin de la asignatura (nuevo)"])
    if fin_asig <= hoy:
        die(f"la asignatura ya terminó ({fin_asig})")
    abrev = plan.get("abrev") or abrev_de(pnombre)
    importancia = int(plan.get("importancia", 2))
    if importancia not in HORAS_SEMANAL:
        die("importancia debe ser 1, 2 o 3")
    ultimo_dia_bloques = fin_asig
    fin_plan = fecha(plan.get("fin"))
    avisos = []
    if fin_plan:
        if fin_plan < inicio:
            die(f"el fin {fin_plan} es anterior al inicio {inicio}")
        if fin_plan > fin_asig:
            die(f"el fin {fin_plan} es posterior al fin de la asignatura ({fin_asig})")
        ultimo_dia_bloques = fin_plan

    # Entregas, en orden de fecha: un id de tarea existente, {"id": N, "due_at": ...} para ponerle
    # fecha si no tiene, o {"nombre", "due_at", "horas"} para crearla (marca ea:entrega:<p>:<tema>:<nombre>;).
    specs = plan.get("entregas")
    if specs is None:
        specs = [plan["entrega"]] if plan.get("entrega") else []
    if not isinstance(specs, list):
        die('"entregas" debe ser una lista')
    dias_def = int(plan.get("dias_entrega", 2))
    sel = "select id, name, due_at, finished_at is not null as hecha from tasks "
    entregas = []
    for ent in specs:
        if not isinstance(ent, dict):
            ent = {"id": int(ent)}
        ent_due = fecha(ent.get("due_at"))
        if "id" in ent:
            e = sql_query(sel + f"where id = {int(ent['id'])} and project_id = {pid};")
            if not e or int(ent["id"]) in borradas:
                die(f"la entrega {ent['id']} no es una tarea del proyecto {pid}")
        else:
            nombre_e = str(ent.get("nombre") or "").strip()
            if not nombre_e or len(nombre_e) > 40 or not ent_due:
                die('entrega nueva: hacen falta "nombre" (≤ 40 caracteres) y "due_at"')
            marca_e = f"ea:entrega:{pid}:{tema}:{slug(nombre_e)};"
            e = [f for f in sql_query(sel + f"where project_id = {pid} and strpos(description, {q(marca_e)}) > 0;")
                 if int(f["id"]) not in borradas]
        if e:
            en = e[0]
            en["ref"], en["nodo"] = en["id"], int(en["id"])
            if not en["due_at"]:
                if not ent_due:
                    die(f'la entrega {en["id"]} no tiene due_at: pon "due_at" en su entrada')
                en["due_at"] = str(ent_due)
                previas.append(
                    f"update tasks set due_at = {q(ent_due)} where id = {en['id']} "
                    "and due_at is null and finished_at is null;"
                )
                filas_previas.append([en["id"], en["name"], ent_due, "entrega: due_at nuevo"])
        else:
            desc_e = (str(ent.get("descripcion") or "").rstrip() + "\n\n" + marca_e).lstrip()
            en = {
                "id": None, "name": nombre_e, "due_at": str(ent_due), "hecha": "f", "nodo": marca_e,
                "ref": f"(select id from tasks where project_id = {pid} and strpos(description, {q(marca_e)}) > 0)",
            }
            previas.append(
                "insert into tasks (project_id, name, description, due_at, priority, estimate_hours) "
                f"select {pid}, {q(nombre_e)}, {q(desc_e)}, {q(ent_due)}, {prioridad}, {horas_de(ent.get('horas'))} "
                f"where not exists (select 1 from tasks where project_id = {pid} "
                f"and strpos(description, {q(marca_e)}) > 0);"
            )
            filas_previas.append(["nuevo", nombre_e, ent_due, "entrega"])
        en["dias"] = int(ent.get("dias", dias_def))
        entregas.append(en)
    if len({en["nodo"] for en in entregas}) != len(entregas):
        die("entrega repetida en el plan")
    for a, b in zip(entregas, entregas[1:]):
        if fecha(b["due_at"]) < fecha(a["due_at"]):
            die(f"las entregas deben ir en orden de fecha: «{b['name']}» vence antes que «{a['name']}»")
    n_ent = len(entregas)

    # Normaliza los bloques: existentes por id, nuevos por marca (proyecto + tema + nombre).
    items, vistos, tramo = [], set(), 0  # tramo k < n_ent: antes de la entrega k; n_ent: después
    for b in bloques:
        if "id" in b:
            clave = ("id", int(b["id"]))
            item = {"id": int(b["id"]), "hito": bool(b.get("hito"))}
        else:
            nombre = str(b.get("nombre") or "").strip()
            if not nombre or len(nombre) > 40:
                die(f"nombre vacío o de más de 40 caracteres: {nombre!r}")
            marca = f"ea:bloque:{pid}:{tema}:{slug(nombre)};"
            clave = ("marca", marca)
            item = {
                "nombre": nombre,
                "marca": marca,
                "descripcion": str(b.get("descripcion") or "").rstrip(),
                "horas": horas_de(b.get("horas")),
                "hito": bool(b.get("hito")),
            }
        if clave in vistos:
            die(f"bloque repetido en el plan: {clave[1]}")
        vistos.add(clave)
        if b.get("despues") or not n_ent:
            t = n_ent
        elif "entrega" in b:
            t = int(b["entrega"]) - 1
            if not 0 <= t < n_ent:
                die(f"bloque {clave[1]}: \"entrega\" debe ir de 1 a {n_ent}")
        else:
            t = tramo
        if t < tramo:
            die(f"bloque {clave[1]}: los bloques deben ir en orden de entrega")
        tramo = item["tramo"] = t
        items.append(item)

    ids = [it["id"] for it in items if "id" in it]
    estado = {}
    if ids:
        for f in sql_query(
            "select id, name, due_at, finished_at is not null as hecha, project_id from tasks "
            f"where id in ({','.join(map(str, ids))});"
        ):
            estado[int(f["id"])] = f
    for i in ids:
        if i in borradas:
            die(f"la tarea {i} está en el plan y en --como-borradas")
        if i not in estado or int(estado[i]["project_id"]) != pid:
            die(f"la tarea {i} no existe o no es del proyecto {pid}")
    marcas = [it["marca"] for it in items if "marca" in it]
    ya_creados = {}  # marca -> id
    if marcas:
        cond = " or ".join(f"strpos(description, {q(m)}) > 0" for m in marcas)
        for f in sql_query(f"select id, description from tasks where project_id = {pid} and ({cond});"):
            if int(f["id"]) in borradas:
                continue
            ya_creados.update({m: int(f["id"]) for m in marcas if m in f["description"]})

    # Qué bloques necesitan fecha, separados en antes/después de la entrega.
    for it in items:
        if "id" in it:
            f = estado[it["id"]]
            it["nombre"] = f["name"]
            it["ref"] = str(it["id"])
            it["fijo"] = "hecho" if f["hecha"] == "t" else ("ya tenía fecha" if f["due_at"] else None)
            it["due_actual"] = f["due_at"]
        else:
            it["ref"] = f"(select id from tasks where project_id = {pid} and strpos(description, {q(it['marca'])}) > 0)"
            it["fijo"] = "ya creado" if it["marca"] in ya_creados else None
    pendientes = [it for it in items if not it["fijo"]]

    # El ritmo se reparte entre los bloques pendientes solo si queda algún hito por fechar; si los
    # hitos ya tienen fecha (plan ya aplicado), los demás solo heredan y no se recalcula nada.
    if not any(it["hito"] for it in items) and pendientes:
        die('ningún bloque es hito: marca con "hito": true los que deben llevar fecha')
    for it in pendientes:
        it["due"] = None
    if any(it["hito"] for it in pendientes):
        if inicio < hoy:
            die(f"el inicio {inicio} ya ha pasado")
        # Las entregas hechas o ya pasadas no abren tramo: sus bloques van al siguiente.
        abiertas_e = [k for k, en in enumerate(entregas) if en["hecha"] != "t" and fecha(en["due_at"]) >= inicio]
        for k, en in enumerate(entregas):
            if k not in abiertas_e:
                avisos.append(f"la entrega «{en['name']}» ya pasó o está hecha: sus bloques van al tramo siguiente")
        grupos = {}
        for it in pendientes:
            grupos.setdefault(next((k for k in abiertas_e if k >= it["tramo"]), n_ent), []).append(it)
        ini, orden = inicio, []
        for k in abiertas_e + [n_ent]:
            grupo = grupos.get(k, [])
            if k < n_ent:
                en = entregas[k]
                e_due = fecha(en["due_at"])
                fin_k = min(e_due - dt.timedelta(days=en["dias"]), ultimo_dia_bloques)
                etiqueta = f"antes de «{en['name']}»"
            else:
                fin_k = ultimo_dia_bloques
                etiqueta = f"después de «{entregas[abiertas_e[-1]]['name']}»" if abiertas_e else "bloques"
            fechas, av = repartir(len(grupo), ini, fin_k, max_por_dia, etiqueta)
            avisos += av
            for it, d in zip(grupo, fechas):
                it["due"] = d
            orden += grupo
            if k < n_ent:
                ini = max(inicio, e_due + dt.timedelta(days=1))
        pendientes = orden  # orden de fechas

    # gv muestra cada tarea con la fecha más temprana entre ella y lo que depende de ella
    # (task_effective_due): así se calcula qué fecha verá cada bloque tras aplicar el plan.
    abiertas = {
        int(f["id"]): f for f in sql_query("select id, name, due_at from tasks where finished_at is null;")
        if int(f["id"]) not in borradas
    }
    dependientes = {}
    for f in sql_query(
        "select d.task_id, d.depends_on from task_dependencies d join tasks t on t.id = d.task_id "
        "where t.finished_at is null;"
    ):
        if int(f["task_id"]) not in borradas and int(f["depends_on"]) not in borradas:
            dependientes.setdefault(int(f["depends_on"]), []).append(int(f["task_id"]))
    dependientes_bd = {k: list(v) for k, v in dependientes.items()}
    nodo = lambda it: it.get("id") or ya_creados.get(it["marca"]) or it["marca"]
    for prev, it in zip(items, items[1:]):
        if "marca" in it and it["marca"] not in ya_creados:
            dependientes.setdefault(nodo(prev), []).append(nodo(it))
    # Cada entrega abierta depende del último bloque de su tramo.
    deps_entrega = []
    for k, en in enumerate(entregas):
        suyos = [it for it in items if it["tramo"] == k]
        if en["hecha"] == "t" or not suyos:
            continue
        u = suyos[-1]
        if not (isinstance(en["nodo"], int) and en["nodo"] in dependientes_bd.get(nodo(u), [])):
            deps_entrega.append((en, u))
        if en["nodo"] not in dependientes.get(nodo(u), []):
            dependientes.setdefault(nodo(u), []).append(en["nodo"])
    vence = {n: fecha(f["due_at"]) for n, f in abiertas.items() if f["due_at"]}
    vence.update({nodo(it): it["due"] for it in pendientes if it["hito"]})
    vence.update({en["nodo"]: fecha(en["due_at"]) for en in entregas if en["hecha"] != "t"})
    nombre_de = {n: f["name"] for n, f in abiertas.items()}
    for en in entregas:
        nombre_de.setdefault(en["nodo"], en["name"])
    nombre_de.update({nodo(it): it["nombre"] for it in items if nodo(it) not in nombre_de})

    del_plan = {nodo(it) for it in items}

    def efectiva(n0):
        """(fecha que gv dará a n0, tarea que la impone, tareas fuera del plan por las que pasa)."""
        mejor, por, pila, padre = None, None, [n0], {n0: None}
        while pila:
            n = pila.pop()
            if vence.get(n) and (mejor is None or vence[n] < mejor):
                mejor, por = vence[n], n
            for m in dependientes.get(n, []):
                if m not in padre:
                    padre[m] = n
                    pila.append(m)
        via, n = [], padre.get(por)
        while n is not None and n != n0:
            if n not in del_plan:
                via.insert(0, n)
            n = padre[n]
        return mejor, por, tuple(via)

    filas, sentencias, adelantan, sin_fecha = list(filas_previas), list(previas), {}, []
    for it in items:
        if it["fijo"]:
            filas.append([it["ref"] if "id" in it else "—", it["nombre"], it.get("due_actual") or "—", f"{it['fijo']}: sin cambios"])
    for it in pendientes:
        ef, por, via = efectiva(nodo(it))
        ref = it["id"] if "id" in it else "nuevo"
        ritmo = f" (ritmo {it['due']})" if it["due"] else ""
        if it["hito"]:
            filas.append([ref, it["nombre"], it["due"], "hito"])
        elif ef:
            filas.append([ref, it["nombre"], "—", f"sin fecha propia; en gv, {ef}" + ritmo])
        else:
            filas.append([ref, it["nombre"], "—", "sin fecha en gv" + ritmo])
            sin_fecha.append(it["nombre"])
        if ef and it["due"] and ef < it["due"] and por != nodo(it):
            adelantan.setdefault((por, via), []).append(str(ref) if "id" in it else it["nombre"])
        if "id" in it and it["hito"]:
            sentencias.append(
                f"update tasks set due_at = {q(it['due'])} where id = {it['id']} "
                "and due_at is null and finished_at is null;"
            )
        elif "marca" in it:
            desc = (it["descripcion"] + "\n\n" + it["marca"]).lstrip()
            due_sql = q(it["due"]) if it["hito"] else "null"
            sentencias.append(
                "insert into tasks (project_id, name, description, due_at, priority, estimate_hours) "
                f"select {pid}, {q(it['nombre'])}, {q(desc)}, {due_sql}, {prioridad}, {it['horas']} "
                f"where not exists (select 1 from tasks where project_id = {pid} "
                f"and strpos(description, {q(it['marca'])}) > 0);"
            )
    tarea = lambda n: f"«{nombre_de[n]}» ({n if isinstance(n, int) else 'nueva'})"
    for (por, via), refs in adelantan.items():
        camino = f" a través de {', '.join(tarea(n) for n in via)}" if via else ""
        avisos.append(
            f"{tarea(por)}, que vence el {vence[por]}, depende de {', '.join(refs)}{camino}: gv les mostrará "
            "esa fecha, antes que su ritmo. Si no debe, que el usuario quite esa dependencia en gv "
            "(o borre la tarea que sobre)"
        )
    if sin_fecha:
        avisos.append(
            f"sin fecha en gv (ningún hito ni tarea con fecha depende de ellos): {', '.join(sin_fecha)}. "
            "Marca como hito alguno posterior"
        )

    # Dependencias: solo las de bloques nuevos con su anterior en el plan; nunca en tareas existentes.
    for prev, it in zip(items, items[1:]):
        if "marca" in it and it["marca"] not in ya_creados:
            sentencias.append(
                f"insert into task_dependencies (task_id, depends_on) select {it['ref']}, {prev['ref']} "
                f"where not exists (select 1 from task_dependencies where task_id = {it['ref']} "
                f"and depends_on = {prev['ref']});"
            )
    for en, u in deps_entrega:
        sentencias.append(
            f"insert into task_dependencies (task_id, depends_on) select {en['ref']}, {u['ref']} "
            f"where not exists (select 1 from task_dependencies where task_id = {en['ref']} "
            f"and depends_on = {u['ref']});"
        )
        filas.append(["—", en["name"], en["due_at"], f"entrega: depende de «{u['nombre']}»"])
    if any("marca" in it for it in pendientes) or deps_entrega:
        sentencias.append(
            "do $$ begin if exists (select 1 from task_dependencies d join tasks t on t.id = d.task_id "
            f"where t.project_id = {pid} and task_dependency_would_cycle(d.task_id, array[d.depends_on])) "
            "then raise exception 'estudio-plan: ciclo de dependencias'; end if; end $$;"
        )

    # Repaso semanal recurrente y repaso final de la asignatura (uno de cada por proyecto).
    marcas_rep = [
        m for m in sql_query(
            "select id, project_id, due_at, description from tasks where finished_at is null and ("
            f"strpos(description, {q(SEMANAL + ':')}) > 0 or strpos(description, {q(FINAL + ':')}) > 0);"
        )
        if int(m["id"]) not in borradas
    ]
    mia = lambda m, tipo: m["project_id"] == str(pid) and f"{tipo}:{pid};" in m["description"]
    if HORAS_SEMANAL[importancia] is None:
        avisos.append("importancia 1: no se crean repasos semanal ni final")
    elif not any(mia(m, SEMANAL) for m in marcas_rep):
        usados = {fecha(m["due_at"]).weekday() for m in marcas_rep if SEMANAL in m["description"] and m["due_at"]}
        dia = next((d for d in range(5) if d not in usados), 5)
        due = inicio + dt.timedelta(days=2)
        due += dt.timedelta(days=(dia - due.weekday()) % 7)
        if due >= fin_asig - dt.timedelta(days=MARGEN_FINAL):
            avisos.append("no se crea repaso semanal: ya no cabe antes del repaso final")
        else:
            nombre = f"Repaso semanal {abrev}"[:40]
            desc = (
                f"Repaso de memoria de toda la asignatura (~{round(HORAS_SEMANAL[importancia] * 60)} min). Lánzalo con /estudio-asentar desde la "
                f"carpeta de la asignatura y di «repaso». Al terminar, Renew.\n\n{SEMANAL}:{pid};"
            )
            sentencias.append(
                "insert into tasks (project_id, name, description, due_at, priority, estimate_hours, task_type, recurrence) "
                f"select {pid}, {q(nombre)}, {q(desc)}, {q(due)}, {prioridad}, {HORAS_SEMANAL[importancia]:.2f}, 'recurring', 7 "
                f"where not exists (select 1 from tasks where finished_at is null "
                f"and strpos(description, {q(f'{SEMANAL}:{pid};')}) > 0);"
            )
            filas.append(["nuevo", nombre, due, f"recurrente cada 7 días (empieza en {DIAS[due.weekday()]})"])
    if HORAS_FINAL[importancia] is not None and not any(mia(m, FINAL) for m in marcas_rep):
        otros = {fecha(m["due_at"]) for m in marcas_rep if FINAL in m["description"] and m["due_at"]}
        due = fin_asig - dt.timedelta(days=MARGEN_FINAL)
        while due in otros and due > hoy + dt.timedelta(days=1):
            due -= dt.timedelta(days=1)
        due = max(due, hoy + dt.timedelta(days=1))
        nombre = f"Repaso final {abrev}"[:40]
        desc = (
            f"Repaso final mezclado de toda la asignatura (~{round(HORAS_FINAL[importancia] * 60)} min), material cerrado. Lánzalo con "
            f"/estudio-asentar desde la carpeta de la asignatura y di «repaso final».\n\n{FINAL}:{pid};"
        )
        sentencias.append(
            "insert into tasks (project_id, name, description, due_at, priority, estimate_hours) "
            f"select {pid}, {q(nombre)}, {q(desc)}, {q(due)}, {prioridad}, {HORAS_FINAL[importancia]:.2f} "
            f"where not exists (select 1 from tasks where finished_at is null "
            f"and strpos(description, {q(f'{FINAL}:{pid};')}) > 0);"
        )
        filas.append(["nuevo", nombre, due, "repaso final"])

    print(f"{pnombre} ({abrev}) · tema {tema} · importancia {importancia} · fin de la asignatura {fin_asig}", file=sys.stderr)
    for en in entregas:
        print(f"Entrega: {en['name']} (due_at {en['due_at']}, {en['dias']} días reservados)", file=sys.stderr)
    print(tabla(filas, ["id", "tarea", "due_at", "qué"]), file=sys.stderr)
    for a in avisos:
        print(f"aviso: {a}", file=sys.stderr)

    if not sentencias:
        print("Nada que crear.", file=sys.stderr)
        return
    sql = "begin;\n" + "\n".join(sentencias) + "\ncommit;\n"
    if salida:
        with open(salida, "w") as fh:
            fh.write(sql)
    elif not aplicar:
        print(sql)
    if aplicar:
        proc = subprocess.run(["gv-api-sql", "--write"], input=sql, capture_output=True, text=True)
        if proc.returncode != 0:
            die(f"fallo al escribir en gv (no se ha aplicado nada):\n{proc.stderr.strip()}")
        cambios = [l for l in proc.stdout.splitlines() if l.startswith(("INSERT", "UPDATE"))]
        hechos = sum(int(l.split()[-1]) for l in cambios)
        print(f"Aplicado en gv: {hechos} filas creadas o con fecha nueva.", file=sys.stderr)


# ---------------------------------------------------------------- corrección (solo a petición)


def tarea_abierta(tid):
    f = sql_query(
        "select t.id, t.name, t.due_at, t.finished_at is not null as hecha, p.name as proyecto "
        f"from tasks t join projects p on p.id = t.project_id where t.id = {int(tid)};"
    )
    if not f:
        die(f"no existe la tarea {tid}")
    if f[0]["hecha"] == "t":
        die(f"la tarea {tid} «{f[0]['name']}» ya está hecha")
    return f[0]


def escribir(sql, aplicar, resumen):
    print(resumen, file=sys.stderr)
    if not aplicar:
        print(sql)
        print("(vista previa: repite con --aplicar para escribirlo en gv)", file=sys.stderr)
        return
    proc = subprocess.run(["gv-api-sql", "--write"], input=f"begin;\n{sql}\ncommit;\n", capture_output=True, text=True)
    if proc.returncode != 0:
        die(f"fallo al escribir en gv (no se ha aplicado nada):\n{proc.stderr.strip()}")
    filas = sum(int(l.split()[-1]) for l in proc.stdout.splitlines() if l.startswith(("INSERT", "UPDATE", "DELETE")))
    print(f"Aplicado en gv: {filas} filas.", file=sys.stderr)


def cmd_mover(tid, nueva, aplicar):
    t, d = tarea_abierta(tid), dt.date.fromisoformat(nueva)
    escribir(
        f"update tasks set due_at = {q(d)} where id = {t['id']} and finished_at is null;",
        aplicar, f"mover «{t['name']}» ({t['id']}, {t['proyecto']}): {t['due_at'] or 'sin fecha'} → {d}",
    )


def cmd_dep(tid, de, aplicar):
    t, d = tarea_abierta(tid), tarea_abierta(de)
    if t["id"] == d["id"]:
        die("una tarea no puede depender de sí misma")
    f = sql_query(
        f"select exists (select 1 from task_dependencies where task_id = {t['id']} and depends_on = {d['id']}) as hay, "
        f"task_dependency_would_cycle({t['id']}, array[{d['id']}]) as ciclo;"
    )[0]
    if f["hay"] == "t":
        die("esa dependencia ya existe")
    if f["ciclo"] == "t":
        die("esa dependencia crearía un ciclo")
    escribir(
        f"insert into task_dependencies (task_id, depends_on) select {t['id']}, {d['id']} "
        f"where not task_dependency_would_cycle({t['id']}, array[{d['id']}]);",
        aplicar, f"«{t['name']}» ({t['id']}) pasa a depender de «{d['name']}» ({d['id']})",
    )


def cmd_quitar_dep(tid, de, aplicar):
    f = sql_query(
        "select a.name as t, b.name as d from task_dependencies x join tasks a on a.id = x.task_id "
        f"join tasks b on b.id = x.depends_on where x.task_id = {int(tid)} and x.depends_on = {int(de)};"
    )
    if not f:
        die(f"la tarea {tid} no depende de {de}")
    escribir(
        f"delete from task_dependencies where task_id = {int(tid)} and depends_on = {int(de)};",
        aplicar, f"«{f[0]['t']}» ({tid}) deja de depender de «{f[0]['d']}» ({de})",
    )


def cmd_borrar(tids, aplicar):
    sentencias, resumen = [], []
    for tid in dict.fromkeys(tids):
        sql, linea = borrado(tid)
        sentencias.append(sql)
        resumen.append(linea)
    escribir("\n".join(sentencias), aplicar, "\n".join(resumen))


def borrado(tid):
    t = tarea_abierta(tid)
    f = sql_query(
        f"select (select count(*) from time_entries where task_id = {t['id']}) as tiempo, "
        f"(select count(*) from todos where task_id = {t['id']}) as todos, "
        f"(select count(*) from recurring_commitments where task_id = {t['id']}) as compromisos, "
        f"(select string_agg(task_id::text, ',') from task_dependencies where depends_on = {t['id']}) as dependen;"
    )[0]
    if int(f["tiempo"]) or int(f["todos"]) or int(f["compromisos"]):
        die(f"la tarea {t['id']} tiene tiempo registrado, todos o compromisos: bórrala tú en gv si de verdad sobra")
    aviso = f"; dejan de depender de ella: {f['dependen']}" if f["dependen"] else ""
    return (
        f"delete from tasks where id = {t['id']} and finished_at is null;",
        f"borrar «{t['name']}» ({t['id']}, {t['proyecto']}, due {t['due_at'] or '—'}){aviso}",
    )


def cmd_horas(pares, aplicar):
    if not pares or len(pares) % 2:
        die("uso: estudio-plan horas <tarea> <h> [<tarea> <h>...]")
    sentencias, resumen = [], []
    for tid, h in zip(pares[::2], pares[1::2]):
        t, horas = tarea_abierta(tid), horas_de(h)
        actual = sql_query(f"select estimate_hours from tasks where id = {t['id']};")[0]["estimate_hours"]
        sentencias.append(f"update tasks set estimate_hours = {horas} where id = {t['id']} and finished_at is null;")
        resumen.append(f"«{t['name']}» ({t['id']}): {actual or '—'} h → {horas} h")
    escribir("\n".join(sentencias), aplicar, "\n".join(resumen))


def cmd_repasos(proyecto, importancia, aplicar):
    pid, imp = int(proyecto), int(importancia)
    if imp not in HORAS_SEMANAL:
        die("importancia debe ser 1, 2 o 3")
    if HORAS_SEMANAL[imp] is None:
        die("en importancia 1 no hay repasos: si el usuario lo pide, bórralos con `estudio-plan borrar`")
    filas = sql_query(
        "select id, name, description, estimate_hours from tasks where finished_at is null and "
        f"(strpos(description, {q(f'{SEMANAL}:{pid};')}) > 0 or strpos(description, {q(f'{FINAL}:{pid};')}) > 0);"
    )
    if not filas:
        die(f"el proyecto {pid} no tiene repasos creados por estudio-plan")
    sentencias, resumen = [], []
    for f in filas:
        horas = HORAS_SEMANAL[imp] if SEMANAL in f["description"] else HORAS_FINAL[imp]
        desc = re.sub(r"\(~\d+ min\)", f"(~{round(horas * 60)} min)", f["description"], count=1)
        sentencias.append(
            f"update tasks set estimate_hours = {horas:.2f}, description = {q(desc)} "
            f"where id = {f['id']} and finished_at is null;"
        )
        resumen.append(f"«{f['name']}» ({f['id']}): {f['estimate_hours']} h → {horas:.2f} h (~{round(horas * 60)} min)")
    escribir("\n".join(sentencias), aplicar, "\n".join(resumen))


def main(argv):
    hoy = dt.date.today()
    if "--hoy" in argv:
        i = argv.index("--hoy")
        hoy = dt.date.fromisoformat(argv[i + 1])
        del argv[i : i + 2]
    salida = None
    if "-o" in argv:
        i = argv.index("-o")
        salida = argv[i + 1]
        del argv[i : i + 2]
    borradas = frozenset()
    if "--como-borradas" in argv:
        i = argv.index("--como-borradas")
        borradas = frozenset(int(x) for x in argv[i + 1].split(",") if x.strip())
        del argv[i : i + 2]
    aplicar = "--aplicar" in argv
    argv = [a for a in argv if a != "--aplicar"]
    if len(argv) >= 1 and argv[0] == "proyectos":
        cmd_proyectos()
    elif len(argv) == 2 and argv[0] == "estado":
        cmd_estado(argv[1], hoy)
    elif len(argv) == 2 and argv[0] == "plan":
        cmd_plan(argv[1], hoy, salida, aplicar, borradas)
    elif len(argv) == 3 and argv[0] == "mover":
        cmd_mover(argv[1], argv[2], aplicar)
    elif len(argv) == 3 and argv[0] == "dep":
        cmd_dep(argv[1], argv[2], aplicar)
    elif len(argv) == 3 and argv[0] == "quitar-dep":
        cmd_quitar_dep(argv[1], argv[2], aplicar)
    elif len(argv) == 3 and argv[0] == "repasos":
        cmd_repasos(argv[1], argv[2], aplicar)
    elif len(argv) >= 3 and argv[0] == "horas":
        cmd_horas(argv[1:], aplicar)
    elif len(argv) >= 2 and argv[0] == "borrar":
        cmd_borrar(argv[1:], aplicar)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Error as e:
        sys.exit(f"estudio-plan: {e}")
    except (KeyError, ValueError, TypeError, IndexError, AttributeError) as e:
        sys.exit(f"estudio-plan: entrada no válida ({type(e).__name__}: {e})")
