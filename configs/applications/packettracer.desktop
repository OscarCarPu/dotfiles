[Desktop Entry]
# The AUR package ships no .desktop file; launches through scripts/packettracer.
# Absolute path: see ardour9.desktop.
Name=Cisco Packet Tracer
Exec=/home/ocp/.local/bin/packettracer %f
Icon=applications-internet
Type=Application
Categories=Network;Education;
MimeType=application/x-pkt;application/x-pka;application/x-pkz;
