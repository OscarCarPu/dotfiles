# Local secrets — sourced by install.sh and by the git filters that keep
# credentials out of tracked config files.
#
# Copy to ~/.config/dotfiles/secrets.env and chmod 600. Never commit the real
# file: it lives outside the repo on purpose, so there is nothing to ignore.
#
#   install -Dm600 configs/secrets.env.example ~/.config/dotfiles/secrets.env
#   $EDITOR ~/.config/dotfiles/secrets.env
#   bash install.sh          # registers the filters and re-materialises values

# PrusaLink password for the CORE One (OrcaSlicer `printhost_password`).
# User is `maker`; find the password on the printer: Settings > Network > PrusaLink.
ORCA_PRINTHOST_PASSWORD=""
